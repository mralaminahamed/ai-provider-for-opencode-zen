{
    "name": "mralaminahamed/alamin-ai-provider-for-opencode-zen",
    "description": "Alamin AI Provider for OpenCode Zen — an independent OpenCode Zen integration for the WordPress AI Client.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Al Amin Ahamed",
            "email": "mralaminahamed@gmail.com",
            "homepage": "https://github.com/mralaminahamed"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "wordpress/wp-ai-client": "^0.4"
    },
    "require-dev": {
        "brain/monkey": "^2.7",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "AlAminAhamed\\OpenCodeZenAiProvider\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "php-http/discovery": true
        },
        "sort-packages": true
    },
    "scripts": {
        "phpcs": "phpcs -ps --standard=phpcs.xml.dist",
        "phpcbf": "phpcs -ps --standard=phpcs.xml.dist --runtime-set testVersion 7.4-",
        "phpstan": "phpstan analyse --configuration=phpstan.neon.dist",
        "test": "phpunit"
    }
}
